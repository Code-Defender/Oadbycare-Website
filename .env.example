# Oadby Care Environment Configuration Example
# Copy this file to .env.local to override default values in development.

# Application Information
VITE_APP_NAME="Oadby Care"
VITE_APP_URL="https://oadbycare.co.uk"

# Contact & Emergency Settings
VITE_SUPPORT_PHONE="0123 456 0000"
VITE_EMERGENCY_PHONE="0800 123 4567"
VITE_SUPPORT_EMAIL="info@oadbycare.co.uk"

# API Endpoints (when connected to backend)
VITE_API_BASE_URL="/api"

